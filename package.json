{
  "name": "siglus-ssu-vscode",
  "displayName": "SiglusSS Support",
  "description": "VS Code support for SiglusSceneScript via siglus-ssu.",
  "version": "0.0.14",
  "publisher": "Jirehlov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jirehlov/siglus-ssu-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "files": [
    "out",
    "node_modules",
    "syntaxes",
    "language-configuration.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "colors": [
      {
        "id": "siglusSS.readFlagBackground",
        "description": "Background of source fragments marked as read in read.sav.",
        "defaults": { "dark": "#268BEB33", "light": "#1769AA26", "highContrast": "#268BEB66", "highContrastLight": "#1769AA33" }
      },
      {
        "id": "siglusSS.unreadFlagBackground",
        "description": "Background of source fragments not marked as read in read.sav.",
        "defaults": { "dark": "#FF315C80", "light": "#D32F4F66", "highContrast": "#FF315CB3", "highContrastLight": "#C6204080" }
      },
      {
        "id": "siglusSS.mixedFlagBackground",
        "description": "Background where read and unread flag source ranges overlap.",
        "defaults": { "dark": "#9C80DC40", "light": "#7951B82E", "highContrast": "#9C80DC66", "highContrastLight": "#7951B844" }
      }
    ],
    "languages": [
      {
        "id": "siglusss",
        "aliases": [
          "SiglusSS",
          "SiglusSceneScript"
        ],
        "extensions": [
          ".ss",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "siglusss",
        "scopeName": "source.siglusss",
        "path": "./syntaxes/siglusss.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "dialogue",
        "superType": "string",
        "description": "Dialogue text classified by siglus-ssu textmap semantics."
      },
      {
        "id": "element",
        "superType": "function",
        "description": "System elements classified by the Siglus compiler tables."
      },
      {
        "id": "speakerName",
        "superType": "type",
        "description": "Speaker-name text classified by siglus-ssu compiler semantics."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unused",
        "description": "Marks declarations that are never referenced in the current workspace scan."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "siglusss",
        "scopes": {
          "dialogue": [
            "markup.quote.siglusss",
            "markup.inserted.siglusss",
            "string.quoted.double.siglusss",
            "string.quoted.single.siglusss"
          ],
          "element": [
            "support.function.siglusss",
            "support.variable.siglusss",
            "support.function",
            "support.variable"
          ],
          "speakerName": [
            "entity.name.section.siglusss",
            "entity.name.type.siglusss",
            "markup.heading.siglusss"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "siglusSS.restartLanguageServer",
        "title": "SiglusSS: Restart Language Server"
      },
      {
        "command": "siglusSS.selectConstProfile",
        "title": "SiglusSS: Select Const Profile"
      },
      {
        "command": "siglusSS.readFlags",
        "title": "SiglusSS: Read Flags"
      },
      {
        "command": "siglusSS.refreshReadFlags",
        "title": "SiglusSS: Refresh Read Flags",
        "enablement": "config.siglusSS.readFlagsMode"
      },
      {
        "command": "siglusSS.goToFirstUnreadFlag",
        "title": "SiglusSS: Go to First Unread Flag",
        "enablement": "editorLangId == siglusss && config.siglusSS.readFlagsMode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "siglusSS.goToFirstUnreadFlag",
          "when": "false"
        },
        {
          "command": "siglusSS.readFlags",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "siglusSS.goToFirstUnreadFlag",
          "when": "editorLangId == siglusss && resourceExtname =~ /^\\.ss$/i",
          "group": "navigation@90"
        }
      ]
    },
    "configurationDefaults": {
      "[siglusss]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.defaultColorDecorators": "never",
        "files.encoding": "shiftjis",
        "files.autoGuessEncoding": true
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "dialogue:siglusss": {
            "foreground": "#F6A400"
          },
          "element:siglusss": {
            "foreground": "#12B5A5",
            "bold": true
          },
          "speakerName:siglusss": {
            "foreground": "#3BA8FF",
            "bold": true
          },
          "macro.unused:siglusss": {
            "foreground": "#7F8790",
            "italic": true
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "markup.quote.siglusss",
              "markup.inserted.siglusss",
              "string.quoted.double.siglusss",
              "string.quoted.single.siglusss"
            ],
            "settings": {
              "foreground": "#F6A400"
            }
          },
          {
            "scope": [
              "meta.speaker.siglusss",
              "entity.name.section.siglusss",
              "entity.name.type.siglusss",
              "markup.heading.siglusss"
            ],
            "settings": {
              "foreground": "#3BA8FF",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "punctuation.definition.string.begin.siglusss",
              "punctuation.definition.string.end.siglusss"
            ],
            "settings": {
              "foreground": "#FF4F8B",
              "fontStyle": "bold"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "SiglusSS",
      "properties": {
        "siglusSS.readFlagsMode": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Enable read flags mode for saved states, precise source backgrounds, counts, hover details, and navigation. Click the **Read Flags** status item and choose **Enable Read Flags Mode** or **Disable Read Flags Mode**. Changes restart the language server. Turning the mode off stops saved-flag processing and keeps the selected save path. If no save is selected, enabling the mode opens a file picker first."
        },
        "siglusSS.readSavPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Selected path to the game's `read.sav`, used while `siglusSS.readFlagsMode` is enabled. Requires a `siglus-ssu` build with read-flag support. Click the **Read Flags** status item and choose **Select Read Save...** to select or replace a file without toggling the mode or moving the cursor. Supports the same path variables as `siglusSS.siglusSsuPath`; relative paths use the workspace directory. Changes restart the server only while read flags mode is enabled. An empty path uses `--read-sav` from `siglusSS.serverExtraArgs` when the mode is enabled."
        },
        "siglusSS.siglusSsuPath": {
          "type": "string",
          "default": "siglus-ssu",
          "markdownDescription": "Either the path to the `siglus-ssu` executable, or the root directory of a `uv` project that should run `uv run siglus-ssu`. Leave it as `siglus-ssu` to use the command installed into PATH, such as a pip-installed command."
        },
        "siglusSS.serverExtraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Extra arguments passed to `siglus-ssu -lsp`. Prefer `siglusSS.constProfile` for profile selection."
        },
        "siglusSS.autoUpdateSiglusSsu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically check PyPI for `siglus-ssu` updates after the language server starts. When an update is available, the extension prompts before installing it."
        },
        "siglusSS.constProfile": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "Const profile number for the language server. Click **SiglusSS: Profile** in the status bar or run **SiglusSS: Select Const Profile** to query the available numbers from your configured `siglus-ssu`. Changes restart the server. A number overrides `--const-profile` in `siglusSS.serverExtraArgs`. Leave unset or use `null` to honor that legacy argument, or otherwise let the server choose its default."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "1.100.0",
    "typescript": "^5.7.3"
  }
}
